{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allows the doubao web page to read copied images and files for paste support.",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["https://www.doubao.com/*"]
  },
  "permissions": ["core:default", "allow-get-clipboard-payload"]
}
